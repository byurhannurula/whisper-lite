{
  "name": "whisper-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ship": "bash scripts/install.sh",
    "release": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,css,md,yml,yaml}": "prettier --write",
    "*.ts": "eslint --fix",
    "*.rs": "rustfmt --edition 2021"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vite": "^7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
